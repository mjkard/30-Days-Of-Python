#The following is a list of 10 students ages:[19, 22, 19, 24, 20, 25, 26, 24, 25, 24]
#Sort the list and find the min and max age
ages = [19,22,19,24,20,25,26,24,25,24]
print(len(ages))
ages.sort()
print('List sorted: ',ages)
print('Min age is: ',min(ages))
print('Max age is: ',max(ages))
#Add the min age and the max age again to the list
ages[-1:-1]= [19,26] #thereby pushing the previous occupant of index [-1], i.e a no.26,to the right
print(ages)
#Find the median age (one middle item or two middle items divided by two)
print('The index of median age is: ',(len(ages)//2))
print('Therefore the median age is:', ages[6])
#Find the average age (sum of all items divided by their number)
print('Given that the no. of terms is:',len(ages))
avg_age = sum(ages) / 12
print(f'The average age is: {avg_age}')
#Find the range of the ages (max minus min)
print('The range of the ages is: ', max(ages)-min(ages) )
#Compare the value of (min - average) and (max - average), use abs() method
min_avg = abs(min(ages)-avg_age)
max_avg = abs(max(ages)-avg_age)
print(f'The value of the min-avg is {min_avg} and the value of the max-avg is {max_avg} ')
