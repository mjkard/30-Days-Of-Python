#Create fruits, vegetables and animal products tuples. Join the three tuples and assign it to a variable called food_stuff_tp.
fruits = ('apples','oranges','blueberries')
vegetables = ('cucumbers','avocados', 'pomegranate')
animal_products = ('milk', 'meat', 'cotton')
food_stuff_tp = fruits + animal_products + vegetables
print(f'Everything joined together is: {food_stuff_tp}')
#Change the about food_stuff_tp tuple to a food_stuff_lt list
food_stuff_lt = list(food_stuff_tp)
print('Now a tuple: ', food_stuff_lt)
#Slice out the middle item or items from the food_stuff_tp tuple or food_stuff_lt list.
print(len(food_stuff_lt))
middle_items = food_stuff_lt[3:6]
print(f'The three middle items are: {middle_items} and the sole middle item is:', food_stuff_lt[4])
#Slice out the first three items and the last three items from food_stuff_lt list
first_3 = food_stuff_tp[0:3]
last_3 = food_stuff_tp[-3:]
print(f'The first three items are: {first_3}.\nAnd the last three items are: {last_3}')
#Delete the food_stuff_tp tuple completely
del food_stuff_tp
#print(food_stuff_tp) will: shows ERROR because it no longer exist now.
